{
  "manifest_version": 3,
  "name": "ほんやく 動画翻訳",
  "short_name": "ほんやく動画",
  "version": "1.0.0",
  "description": "海外の動画を見ながら、字幕や音声を日本語にリアルタイム翻訳して画面に重ねて表示します。",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "tabCapture", "offscreen", "tts"],
  "host_permissions": ["https://translate.googleapis.com/*", "https://api.mymemory.translated.net/*"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["dictionaries.js", "text.js", "content.js"],
    "css": ["content.css"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
